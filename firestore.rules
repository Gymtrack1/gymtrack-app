rules_version = '2';

// GymTrack — Firestore Security Rules
//
// Modelo de datos real (visto en index.html):
//   usuarios/{gymId}                      doc de cuenta de gimnasio (o "pending_<email>" antes del 1er login)
//   usuarios/{gymId}/miembros/{id}        incluye metaFitness y planFitnessIA (ver más abajo, Parte 6/7)
//   usuarios/{gymId}/pagos/{id}
//   usuarios/{gymId}/asistencias/{id}
//   usuarios/{gymId}/empleados/{id}
//   usuarios/{gymId}/inventario/{id}
//   usuarios/{gymId}/productos/{id}
//   usuarios/{gymId}/ventas/{id}
//   usuarios/{gymId}/gastos/{id}
//   usuarios/{gymId}/miembrosPublicos/{id}  espejo público mínimo por miembro (ver más abajo)
//   usuarios/{gymId}/registrosProgreso/{id} series registradas desde el QR (ver más abajo)
//   usuarios/{gymId}/pesoCorporal/{id}      peso corporal (staff + portal QR, ver más abajo)
//   usuarios/{gymId}/config/personalizacion espejo público de colores/logo (ver más abajo)
//   usuarios/{gymId}/sugerencias/{id}       buzón anónimo del portal QR (ver más abajo)
//   usuarios/{gymId}/empleadosPublicos/{id} espejo público mínimo por empleado (ver más abajo)
//   usuarios/{gymId}/accesosNoIdentificados/{id} eventos del control de acceso biométrico sin
//                                            miembro asignado (ver más abajo, CONTROL DE ACCESO)
//
// Objetivo principal: que un gimnasio NUNCA pueda leer ni escribir los
// datos de otro gimnasio, sin importar que llame al SDK de Firestore
// directo (saltándose la UI).
//
// Límite conocido (ver aviso al final): el flujo de migración de cuenta
// "pending_<email>" -> uid real se hace hoy con un setDoc del propio
// cliente, copiando el plan/funciones que el admin le asignó. Estas reglas
// no impiden que un gimnasio se reescriba su propio plan/funciones —
// cerrar eso del todo requiere mover esa migración a una Cloud Function.
// Lo que sí garantizan es el aislamiento entre gimnasios.
//
// ─────────────────────────────────────────────────────────────────────────
// PORTAL PÚBLICO DEL CLIENTE (un solo QR por gimnasio → menú de músculos y
// ejercicios, registro de progreso, peso corporal, estatura, fecha de
// nacimiento — ver CHANGELOG.md). La biblioteca de ejercicios (BIBLIOTECA_
// EJERCICIOS) es contenido estático embebido en index.html, no vive en
// Firestore — por eso no hay colección/regla para ella.
// ─────────────────────────────────────────────────────────────────────────
// Un cliente que escanea el QR se autentica de forma ANÓNIMA (signInAnonymously,
// sin cuenta ni contraseña) solo para tener una sesión válida de Firestore. Su
// uid NUNCA coincide con el uid del gimnasio (isOwnerDoc siempre da false para
// él), así que necesita reglas propias, acotadas a lo mínimo:
//
//   usuarios/{gymId}/miembrosPublicos  — espejo de SOLO numero, nombre,
//     vencimientoTs, estatura y fechaNacimiento de cada miembro (mismo id de
//     documento que en miembros/{id}), mantenido por el propio staff
//     (sincronizarMiembroPublico() en index.html, llamada desde saveMiembro,
//     savePago y _guardarImportados). Existe PORQUE Firestore no puede ocultar
//     campos dentro de un mismo documento vía reglas — así el cliente anónimo
//     NUNCA llega a leer teléfono, dirección, notas, etc. de miembros/{id}
//     (esa colección sigue 100% cerrada más abajo, salvo la excepción de
//     escritura acotada que se explica junto a su regla). Lectura pública
//     (get + list) porque el propio dato ya es mínimo/no sensible — el
//     cliente necesita poder buscar por numero+nombre sin backend propio.
//     También permite ACTUALIZAR, pero solo los campos estatura/
//     fechaNacimiento (el cliente los edita desde el portal); numero, nombre
//     y vencimientoTs quedan protegidos, solo el staff los cambia.
//
//   usuarios/{gymId}/registrosProgreso — lectura + creación para cualquier
//     autenticado (incluye anónimos). Cada registro trae ejercicioId y
//     musculo (referencia a BIBLIOTECA_EJERCICIOS en index.html, no a un
//     documento de Firestore). El cliente arma su propia consulta
//     filtrada por where('miembroId','==', su propio id) para ver solo su
//     historial — la regla en sí NO puede garantizar ese filtro (Firestore no
//     puede ligar un uid anónimo a un miembroId), así que el límite real es
//     el mismo nivel de confianza que ya tiene el resto de GymTrack: cierra
//     la puerta a cualquier OTRA colección, pero dentro de esta colección
//     puntual no hay aislamiento por miembro a prueba de manipulación técnica
//     directa. No se permite editar ni borrar desde el portal.
//
//   usuarios/{gymId}/pesoCorporal      — igual que registrosProgreso arriba,
//     mismo alcance y misma nota de confianza.
//
//   usuarios/{gymId}/config/personalizacion — espejo público de SOLO
//     colorAcento/colorFondo/colorTarjetas/logoUrl (mantenido por el staff vía
//     sincronizarPersonalizacionPublica() en index.html). El doc real
//     usuarios/{gymId} sigue 100% cerrado a lectura anónima (trae plan,
//     pinFinanzas, email, etc.) — mismo motivo que miembrosPublicos: Firestore
//     no puede exponer solo algunos campos de un documento vía reglas. Lo usa
//     el portal para verse con los colores/logo del gimnasio en vez del
//     verde/fondo por defecto de GymTrack. Lectura pública, sin escritura
//     pública (el portal nunca cambia la personalización, solo la lee).
//
//   usuarios/{gymId}/miembros          — SIGUE cerrada a lectura anónima (por
//     eso existe el espejo miembrosPublicos). Se abre una única excepción de
//     ESCRITURA: un autenticado puede actualizar un miembro, pero solo si los
//     campos que cambia son exactamente estatura y/o fechaNacimiento — nunca
//     nombre, teléfono, dirección, notas, etc. (verificado con
//     request.resource.data.diff(resource.data).affectedKeys().hasOnly(...),
//     el mecanismo nativo de Firestore para reglas de escritura por campo).
//
// El bloqueo por membresía vencida (no dejar registrar nada si el miembro
// está vencido) se aplica del lado de la app (portalIdentificar en
// index.html) — no es una regla de Firestore a prueba de manipulación
// técnica directa. Mismo nivel de confianza que ya tiene hoy el resto de
// GymTrack, que no tiene backend propio.
//
// ─────────────────────────────────────────────────────────────────────────
// BUZÓN DE SUGERENCIAS (?gym=...&sugerencia=1, ver CHANGELOG.md) — modo
// COMPLETAMENTE APARTE del resto del portal de arriba, activado por un QR
// distinto. Sin identificación de miembro (sin número, sin nombre), así que
// no hay "su propio id" que filtrar como en registrosProgreso/pesoCorporal.
//
//   usuarios/{gymId}/sugerencias — SOLO creación para cualquier autenticado
//     (incluye anónimos), validando que el documento traiga EXACTAMENTE
//     categoria/texto/fecha/leida (nunca miembroId, nombre, ni ningún otro
//     campo que pudiera identificar a quien la mandó — el uid anónimo de
//     Firebase Auth queda en el registro de auth de Firebase, pero JAMÁS se
//     guarda dentro del documento), que categoria sea una de la lista fija
//     (la misma que ofrece el portal como botones), que texto sea texto de
//     máximo 500 caracteres, y que leida venga en false (el cliente nunca
//     puede crear una sugerencia ya marcada como leída). Sin lectura,
//     actualización ni borrado aquí — ni siquiera quien la mandó puede
//     volver a leerla: eso sigue siendo solo del dueño del gimnasio (o
//     admin), vía la regla genérica de más abajo, igual que el resto de las
//     colecciones.
//
// ─────────────────────────────────────────────────────────────────────────
// PORTAL DE EMPLEADOS (?gym=...&staff=1, Parte 14 + Parte 18, ver CHANGELOG.md) — otro modo
// COMPLETAMENTE APARTE, activado por un tercer QR/link distinto (generado desde el panel de
// Empleados). Un empleado se identifica con su nombre + un PIN de 4-6 dígitos (campo pinAcceso
// en empleados/{id}) y, tras el PIN, elige entre (a) registrar SU PROPIO peso/fuerza en un
// ejercicio (o el de un cliente que esté supervisando), igual que puede hacerlo un cliente desde
// su propio portal, o (b) ver, de SOLO LECTURA, el progreso de TODOS los clientes del gym — no
// solo el suyo, a diferencia de registrosProgreso/pesoCorporal arriba (donde cada cliente ve/crea
// lo propio, aunque la regla en sí no aísla por miembro).
//
//   usuarios/{gymId}/empleadosPublicos — espejo de SOLO nombre y pinAcceso de cada empleado
//     (mismo id de documento que en empleados/{id}), mantenido por el propio staff
//     (sincronizarEmpleadoPublico() en index.html, llamada desde saveEmpleado/delEmpleado).
//     Lectura pública (get + list) — el cliente anónimo necesita poder listar los nombres para
//     mostrarlos como botones, y comparar el PIN escrito contra pinAcceso del lado del cliente
//     (no hay forma de "validar un PIN sin revelarlo" con reglas de Firestore: la única
//     alternativa sería una Cloud Function, que este proyecto no tiene). Sin escritura pública —
//     lo sigue manteniendo solo el staff, vía la regla genérica de más abajo. Desde la Parte 18,
//     pinAcceso se guarda HASHEADO (SHA-256) para los PINs nuevos o recién cambiados — PINs
//     viejos siguen en texto plano hasta que se editen (ver _pinEmpleadoValido en index.html,
//     acepta ambos formatos). Esto NO cambia la regla en sí: sigue siendo lectura pública de un
//     valor (hash o texto plano, según el caso), la comparación pasa del lado del cliente.
//
//   Registros que un empleado crea desde "Registrar mi peso" (Parte 18) se guardan en la MISMA
//   colección registrosProgreso de arriba — sin colección nueva ni regla nueva. Le agregan 3
//   campos más al documento (personaTipo:'miembro'|'empleado', personaNombre, registradoPor), que
//   la regla de registrosProgreso no necesita validar (ya es create abierta sin checar forma del
//   documento, igual que el resto de los campos que ya guarda el portal del cliente).
//
//   AVISO DE CONFIANZA (documentado explícitamente porque aquí el "premio" de saltarse la
//   barrera es mayor que en el resto del portal): el PIN es una barrera de UI para filtrar
//   acceso casual — que un cliente cualquiera no vea por accidente el progreso de otros — NO una
//   regla de seguridad a prueba de manipulación técnica directa a Firestore. Cualquiera que llame
//   al SDK/API de Firestore directo (sin pasar por index.html) ya podía leer TODO
//   registrosProgreso/pesoCorporal de un gym con solo autenticarse anónimo (ver nota junto a esas
//   colecciones arriba, sin cambios en esta parte) — lo único que se abre aquí de más es
//   empleadosPublicos (nombre + pinAcceso/pinHash). Mismo nivel de confianza que ya tiene el
//   resto de GymTrack sin backend propio, aplicado ahora a un alcance de datos mayor (todos los
//   clientes, no uno).
//
// ─────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────
// CONTROL DE ACCESO BIOMÉTRICO (ZKTeco, protocolo ADMS, ver CHANGELOG.md) — NO agrega reglas
// nuevas: la Cloud Function receptora (functions/index.js) usa el Admin SDK, que SALTA por
// completo estas reglas de seguridad (son solo para el SDK/cliente de index.html). Se documenta
// aquí solo para que quede claro qué colecciones/campos toca y por qué ya están cubiertos:
//
//   usuarios/{gymId}.equiposAutorizados — array de SN (números de serie) de los equipos
//     biométricos que le pertenecen a este gimnasio. Campo normal del doc usuarios/{gymId}, ya
//     cubierto por la regla `allow update: if isAdmin() || isOwnerDoc(gymId);` de arriba — el
//     staff lo edita como cualquier otro campo de su cuenta. La Cloud Function lo LEE con el
//     Admin SDK (fuera de estas reglas) para resolver a qué gimnasio pertenece un evento entrante
//     por el SN del equipo, y así no aceptar datos de un equipo no registrado.
//
//   usuarios/{gymId}/miembros/{id}.accesoCredencialId — el ID/PIN que el equipo asignó al
//     miembro al enrolarlo (captura manual desde index.html). Campo normal del documento, sin
//     regla aparte (ya cubierto por la regla genérica de colecciones operativas, más abajo).
//
//   usuarios/{gymId}/accesosNoIdentificados/{id} — eventos de acceso cuyo accesoCredencialId no
//     coincidía con ningún miembro al momento de llegar (la Cloud Function los crea con el Admin
//     SDK). El staff los lee/resuelve desde index.html (sección "Accesos sin asignar", tab
//     Alertas) con el SDK normal — cubierto por la misma regla genérica de abajo, sin necesitar
//     una regla propia (es una subcolección de un solo nivel bajo usuarios/{gymId}, igual que
//     asistencias o pagos).
//
// ─────────────────────────────────────────────────────────────────────────
// AGENTE DE IA: META Y PLAN DE FITNESS (Parte 6/7, ver CHANGELOG.md) — NO es
// una colección nueva, son dos campos más dentro del documento miembros/{id}
// ya existente (metaFitness y planFitnessIA), agregados a la misma excepción
// de escritura acotada que ya usan estatura/fechaNacimiento arriba
// (miembrosPublicos y miembros). El cliente edita su propia meta y guarda el
// plan (resumenTexto + hitos con hábitos marcables) que le devolvió la IA,
// sin abrir ningún otro campo del documento — incluye marcar/desmarcar
// hábitos como completados, que también reescribe el campo planFitnessIA
// completo (mismo mecanismo, sin regla aparte). La llamada al Worker de
// Cloudflare que consulta a Gemini pasa por fuera de Firestore por completo
// (fetch directo desde index.html al Worker) — estas reglas no intervienen
// en esa parte, solo en guardar el resultado de vuelta en el documento del
// miembro.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'luismolinac06@gmail.com';
    }

    function isOwnerDoc(gymId) {
      return isSignedIn() && request.auth.uid == gymId;
    }

    function ownsByEmail() {
      return isSignedIn() &&
        'email' in resource.data &&
        resource.data.email == request.auth.token.email;
    }

    match /usuarios/{gymId} {

      // Lectura de un doc puntual: admin, dueño (por uid), o el propio
      // doc "pending_<email>" que coincide con el email autenticado
      // (necesario para el 1er login).
      allow get: if isAdmin() || isOwnerDoc(gymId) || ownsByEmail();

      // Lectura en lista (usada 1 vez al primer login para localizar su
      // "pending_<email>"): OJO — Firestore NO filtra un list() doc por
      // doc. Si la query no trae un where() que acote por el campo que usa
      // la regla (email), Firestore no puede verificar la regla contra el
      // resultado y rechaza la petición COMPLETA (no la recorta). Por eso
      // el cliente (index.html, loadPlan()) siempre debe consultar con
      // where('email','==', email-del-usuario-autenticado) — nunca un
      // getDocs() sin filtro sobre toda la colección. Confirmado con el
      // emulador en rules-test/test.mjs.
      allow list: if isAdmin() || ownsByEmail();

      // Creación: admin da de alta clientes (uid real o pending_<email>).
      // Un gimnasio solo puede crear su propio doc (uid real), en su
      // primer login.
      allow create: if isAdmin() || isOwnerDoc(gymId);

      // Actualización: admin puede editar cualquier cuenta (plan,
      // funciones, etc). Un gimnasio solo puede editar su propio doc
      // (pinFinanzas, msgWhatsApp, msgWhatsAppRecordatorio, y la migración pending_ -> uid real).
      allow update: if isAdmin() || isOwnerDoc(gymId);

      // Borrado: admin (elimina clientes), o el propio dueño borrando su
      // doc "pending_<email>" tras migrarse a su uid real.
      allow delete: if isAdmin() || ownsByEmail();

      // ── PORTAL PÚBLICO DEL CLIENTE — ver nota extensa arriba ──

      // Espejo público mínimo de miembros (numero, nombre, vencimientoTs,
      // estatura, fechaNacimiento, metaFitness, planFitnessIA,
      // categoriaMembresia, metaSemanal — NUNCA teléfono/dirección/notas/
      // etc). Lectura pública; escritura pública acotada solo a esos campos
      // editables desde el portal (estatura/fechaNacimiento del perfil
      // físico, metaFitness de la meta, planFitnessIA como el plan que
      // devolvió la IA — incluye marcar/desmarcar hábitos, misma escritura
      // del campo completo — ver Parte 6/7, CHANGELOG.md). categoriaMembresia
      // y metaSemanal (Parte 20) son de solo lectura desde el portal —
      // contexto para la Recomendación IA, el cliente nunca los edita. El
      // resto de los campos del espejo los mantiene el staff vía la regla
      // genérica de más abajo.
      match /miembrosPublicos/{docId} {
        allow read: if isSignedIn();
        allow update: if isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estatura', 'fechaNacimiento', 'metaFitness', 'planFitnessIA']);
      }

      // Series de progreso por ejercicio y peso corporal: cualquier
      // autenticado (incluye anónimos) puede leer y crear. No hay edición
      // ni borrado desde el portal. Ver nota de confianza arriba sobre el
      // alcance real de "leer" aquí (no hay aislamiento por miembro a
      // prueba de manipulación técnica directa con auth anónima).
      match /registrosProgreso/{docId} {
        allow read, create: if isSignedIn();
      }
      match /pesoCorporal/{docId} {
        allow read, create: if isSignedIn();
      }

      // Espejo público de personalización visual (colores/logo) — solo lectura, el portal
      // nunca lo modifica. Alta/edición sigue siendo del staff vía la regla genérica de abajo.
      match /config/{docId} {
        allow read: if isSignedIn();
      }

      // Excepción de escritura sobre miembros/: el portal público necesita
      // poder guardar estatura/fechaNacimiento/metaFitness/planFitnessIA
      // directamente en el documento real (no solo en el espejo), y esta es
      // la única forma de permitirlo sin abrir el resto del documento
      // (teléfono, dirección, notas, etc. — esos siguen 100% cerrados, ni
      // siquiera de lectura, a cualquiera que no sea el dueño del gimnasio o
      // el admin).
      match /miembros/{miembroId} {
        allow update: if isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estatura', 'fechaNacimiento', 'metaFitness', 'planFitnessIA']);
      }

      // Buzón de sugerencias — ver nota extensa arriba. Solo creación, acotada a la forma
      // exacta del documento; sin lectura/actualización/borrado (eso es solo del dueño del
      // gimnasio, vía la regla genérica de abajo).
      match /sugerencias/{docId} {
        allow create: if isSignedIn() &&
          request.resource.data.keys().hasOnly(['categoria', 'texto', 'fecha', 'leida']) &&
          request.resource.data.categoria in [
            'Máquinas y equipo', 'Limpieza', 'Instalaciones', 'Atención del personal',
            'Clases y horarios', 'Precios y membresías', 'Estacionamiento', 'Otro'
          ] &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() > 0 &&
          request.resource.data.texto.size() <= 500 &&
          request.resource.data.fecha is number &&
          request.resource.data.leida == false;
      }

      // Espejo público de empleados (Vista de Progreso del staff) — ver nota extensa arriba.
      // Solo lectura pública (nombre + pinAcceso); la escritura la sigue haciendo únicamente el
      // staff, vía la regla genérica de abajo.
      match /empleadosPublicos/{docId} {
        allow read: if isSignedIn();
      }

      // RECOMENDACIÓN IA (Parte 20, ver CHANGELOG.md) — {texto, generadoEn, basadoEnRegistros}
      // por miembro, la lee tanto el propio cliente (portal) como el coach (Vista de Progreso del
      // staff — ve TODAS las que ya se generaron, no una por una). Se genera llamando al mismo
      // Worker de Cloudflare que ya usa la Parte 6/7 (cloudflare-worker-ia/, con Gemini) — el
      // cliente arma el payload (fuerza por músculo, ya calculada del lado cliente, más
      // categoría/meta/edad del espejo público) y GUARDA el resultado él mismo, igual que ya hace
      // planFitnessIA con miembros/miembrosPublicos. Mismo nivel de confianza que el resto del
      // portal (registrosProgreso/miembrosPublicos arriba): no hay forma de aislar "solo el
      // propio cliente" con auth anónima, y no hay nada más sensible aquí que en esas colecciones
      // — se valida la FORMA del documento (nunca campos extra) para que quede acotado a lo que
      // esta pantalla necesita.
      match /recomendacionesIA/{miembroId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() &&
          request.resource.data.keys().hasOnly(['texto', 'generadoEn', 'basadoEnRegistros']) &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() > 0 &&
          request.resource.data.generadoEn is number &&
          request.resource.data.basadoEnRegistros is number;

        // Notas tipo bitácora debajo de la recomendación — cualquiera de los dos lados (cliente
        // o coach) puede agregar una, nunca editarla ni borrarla (mantenerlo simple, ver
        // CHANGELOG.md). Se valida la forma EXACTA del documento para que nadie pueda colar
        // campos extra ni un autorTipo inventado. OJO: al ser una subcolección de 2 niveles
        // (recomendacionesIA/{id}/notas/{id}), la regla genérica de abajo (match
        // /{coleccion}/{docId}, un solo nivel) NO la alcanza — por eso el dueño/admin se declara
        // aquí explícito, para conservar el mismo criterio de "el dueño puede todo en su propia
        // cuenta" que ya aplica al resto del archivo.
        match /notas/{notaId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() &&
            request.resource.data.keys().hasOnly(['texto', 'autorNombre', 'autorTipo', 'fecha']) &&
            request.resource.data.texto is string &&
            request.resource.data.texto.size() > 0 &&
            request.resource.data.texto.size() <= 1000 &&
            request.resource.data.autorNombre is string &&
            request.resource.data.autorNombre.size() > 0 &&
            request.resource.data.autorTipo in ['coach', 'cliente'] &&
            request.resource.data.fecha is number;
          allow update, delete: if isAdmin() || isOwnerDoc(gymId);
        }
      }

      // Datos operativos del gimnasio (miembros, pagos, asistencias, etc).
      // Solo el dueño de esa cuenta (o el admin) puede leer/escribir. Esto
      // sigue exactamente igual que antes de agregar el portal: las reglas
      // de arriba son ADICIONALES (Firestore concede acceso si CUALQUIER
      // regla que aplique a la ruta lo permite), nunca reemplazan esta.
      match /{coleccion}/{docId} {
        allow read, write: if isAdmin() || isOwnerDoc(gymId);
      }
    }

    // Cualquier otra ruta: denegada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
