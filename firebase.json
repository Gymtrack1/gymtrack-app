{
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "firebase.json",
      "rules-test/**",
      "functions/**",
      "cloudflare-worker-ia/**",
      "CHANGELOG.md",
      "firestore.rules",
      "storage.rules",
      "storage-cors.json",
      "*.command"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ]
}
